<odoo>

    <record id="res_config_settings_view_form_training_stripe" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.training.stripe</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Training Academy" string="Training Academy" name="training_academy">
                    <block title="Stripe Payments">
                        <setting string="Enable Stripe Checkout"
                                 help="Allow portal students to pay confirmed enrollments through Stripe Checkout.">
                            <field name="training_stripe_enabled"/>
                        </setting>
                        <setting string="Stripe Secret Key"
                                 help="Use a test secret key while developing.">
                            <field name="training_stripe_secret_key"
                                   password="True"
                                   placeholder="sk_test_..."/>
                        </setting>
                        <setting string="Stripe Webhook Secret"
                                 help="Signing secret for /payment/stripe/webhook.">
                            <field name="training_stripe_webhook_secret"
                                   password="True"
                                   placeholder="whsec_..."/>
                        </setting>
                        <setting string="Currency"
                                 help="Three-letter Stripe currency code, for example usd.">
                            <field name="training_stripe_currency"
                                   placeholder="usd"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>

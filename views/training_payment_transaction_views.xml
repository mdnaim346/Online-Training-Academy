<odoo>

    <record id="view_training_payment_transaction_tree" model="ir.ui.view">
        <field name="name">training.payment.transaction.tree</field>
        <field name="model">training.payment.transaction</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'success'"
                  decoration-warning="state == 'pending'"
                  decoration-danger="state in ('failed', 'cancelled')">
                <field name="name"/>
                <field name="create_date"/>
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="amount"/>
                <field name="currency"/>
                <field name="provider"/>
                <field name="stripe_session_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_training_payment_transaction_form" model="ir.ui.view">
        <field name="name">training.payment.transaction.form</field>
        <field name="model">training.payment.transaction</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,pending,success,failed,cancelled"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="enrollment_id" readonly="state != 'draft'"/>
                            <field name="student_id" readonly="1"/>
                            <field name="course_id" readonly="1"/>
                            <field name="payment_id" readonly="1"/>
                        </group>

                        <group>
                            <field name="provider" readonly="1"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency" readonly="state != 'draft'"/>
                            <field name="stripe_session_id" readonly="1"/>
                            <field name="stripe_payment_intent_id" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <field name="checkout_url" readonly="1"/>
                        <field name="raw_payload" readonly="1"/>
                    </group>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_training_payment_transaction_search" model="ir.ui.view">
        <field name="name">training.payment.transaction.search</field>
        <field name="model">training.payment.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="stripe_session_id"/>
                <filter name="pending"
                        string="Pending"
                        domain="[('state','=','pending')]"/>
                <filter name="success"
                        string="Success"
                        domain="[('state','=','success')]"/>
                <filter name="failed"
                        string="Failed/Cancelled"
                        domain="[('state','in',('failed','cancelled'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state"
                            string="Status"
                            context="{'group_by':'state'}"/>
                    <filter name="group_provider"
                            string="Provider"
                            context="{'group_by':'provider'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_training_payment_transaction" model="ir.actions.act_window">
        <field name="name">Payment Transactions</field>
        <field name="res_model">training.payment.transaction</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_training_payment_transaction"
              name="Payment Transactions"
              parent="menu_training_root"
              action="action_training_payment_transaction"
              sequence="36"/>

</odoo>

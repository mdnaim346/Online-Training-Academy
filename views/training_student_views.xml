<odoo>

    <record id="view_training_student_tree" model="ir.ui.view">
        <field name="name">training.student.tree</field>
        <field name="model">training.student</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="enrollment_count"/>
            </tree>
        </field>
    </record>

    <record id="view_training_student_form" model="ir.ui.view">
        <field name="name">training.student.form</field>
        <field name="model">training.student</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_enrollments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-book">
                            <field name="enrollment_count"
                                   widget="statinfo"
                                   string="Enrollments"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="address"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Enrollments">
                            <field name="enrollment_ids">
                                <tree editable="bottom">
                                    <field name="course_id"/>
                                    <field name="enrollment_date"/>
                                    <field name="course_fee"/>
                                    <field name="paid_amount"/>
                                    <field name="due_amount"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_training_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">training.student</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_training_student"
              name="Students"
              parent="menu_training_root"
              action="action_training_student"
              sequence="20"/>

</odoo>
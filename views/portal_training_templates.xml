<odoo>

    <!-- Portal Menu -->
    <template id="portal_my_home_training"
              inherit_id="portal.portal_my_home"
              priority="30">

        <xpath expr="//div[contains(@class, 'o_portal_docs')]"
               position="inside">

            <a href="/my/training"
               class="list-group-item list-group-item-action">

                My Training Enrollments

            </a>

        </xpath>

    </template>

    <!-- Enrollment List -->
    <template id="portal_my_training">

        <t t-call="portal.portal_layout">

            <div class="container py-4 training-portal-page">

                <div class="training-portal-header">
                    <div>
                        <span class="training-eyebrow">Learning portal</span>
                        <h2>My Training Enrollments</h2>
                    </div>
                    <a href="/training/courses" class="btn training-enroll-secondary">
                        Browse Courses
                    </a>
                </div>

                <t t-if="not enrollments">

                    <div class="training-empty-state">
                        <i class="fa fa-folder-open-o"/>
                        <h2>No enrollments found</h2>
                        <p>Your requested and enrolled courses will appear here.</p>
                    </div>

                </t>

                <t t-if="enrollments">

                    <div class="training-portal-table-wrap">
                        <table class="table training-portal-table">

                            <thead>
                                <tr>
                                    <th>Course</th>
                                    <th>Status</th>
                                    <th>Paid</th>
                                    <th>Due</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>

                                <tr t-foreach="enrollments"
                                    t-as="enrollment">

                                    <td class="training-portal-table__course">
                                        <t t-esc="enrollment.course_id.name"/>
                                    </td>

                                    <td>
                                        <span class="training-portal-status">
                                            <t t-esc="enrollment.state"/>
                                        </span>
                                    </td>

                                    <td>
                                        <t t-esc="enrollment.paid_amount"/>
                                    </td>

                                    <td>
                                        <t t-esc="enrollment.due_amount"/>
                                    </td>

                                    <td>

                                        <a t-if="enrollment.state == 'confirmed' and enrollment.due_amount &gt; 0"
                                           t-att-href="'/my/training/enrollment/%s/pay' % enrollment.id"
                                           class="btn training-portal-action">
                                            Pay Now
                                        </a>

                                        <a t-else=""
                                           t-att-href="'/my/training/enrollment/%s' % enrollment.id"
                                           class="btn training-portal-action">

                                            View

                                        </a>

                                    </td>

                                </tr>

                            </tbody>

                        </table>
                    </div>

                </t>

                <section class="training-portal-course-section">
                    <div class="training-portal-section-heading">
                        <span class="training-eyebrow">Available courses</span>
                        <h3>Approved Courses Open for Enrollment</h3>
                    </div>

                    <t t-if="available_courses">
                        <div class="training-course-grid">
                            <t t-foreach="available_courses" t-as="course">
                                <article class="training-course-card">
                                    <div class="training-course-card__top">
                                        <div class="training-course-icon">
                                            <i class="fa fa-graduation-cap"/>
                                        </div>
                                        <span class="training-course-code">
                                            <t t-esc="course.code or 'Course'"/>
                                        </span>
                                    </div>

                                    <h2>
                                        <t t-esc="course.name"/>
                                    </h2>

                                    <p class="training-course-trainer">
                                        <i class="fa fa-user-o"/>
                                        <span>
                                            <t t-esc="course.trainer_id.name or 'Trainer not assigned'"/>
                                        </span>
                                    </p>

                                    <div class="training-course-meta">
                                        <div>
                                            <span>Fee</span>
                                            <strong>
                                                <t t-esc="'%.2f' % course.final_fee"/>
                                            </strong>
                                        </div>
                                        <div>
                                            <span>Seats</span>
                                            <strong>
                                                <t t-esc="course.available_seats"/>
                                            </strong>
                                        </div>
                                        <div>
                                            <span>Duration</span>
                                            <strong>
                                                <t t-esc="course.duration_days"/> days
                                            </strong>
                                        </div>
                                    </div>

                                    <div class="training-course-footer">
                                        <span class="training-course-date">
                                            <i class="fa fa-calendar-o"/>
                                            <t t-if="course.start_date">
                                                <t t-esc="course.start_date"/>
                                            </t>
                                            <t t-else="">Date pending</t>
                                        </span>
                                        <a t-att-href="'/training/course/%s' % course.id"
                                           class="btn training-course-action">
                                            View Details
                                        </a>
                                    </div>
                                </article>
                            </t>
                        </div>
                    </t>

                    <t t-else="">
                        <div class="training-empty-state">
                            <i class="fa fa-calendar-check-o"/>
                            <h2>No approved courses are open</h2>
                            <p>Confirmed courses with available seats will appear here.</p>
                        </div>
                    </t>
                </section>

            </div>

        </t>

    </template>

    <!-- Enrollment Detail -->
    <template id="portal_training_enrollment_detail">

        <t t-call="portal.portal_layout">

            <div class="container py-4 training-portal-page">

                <div class="training-portal-header">
                    <div>
                        <span class="training-eyebrow">Enrollment detail</span>
                        <h2>
                            <t t-esc="enrollment.course_id.name"/>
                        </h2>
                    </div>
                    <a href="/my/training" class="btn training-enroll-secondary">
                        Back to Enrollments
                    </a>
                </div>

                <t t-if="payment_success">
                    <div class="alert alert-success">
                        <t t-esc="payment_success"/>
                    </div>
                </t>

                <t t-if="payment_error">
                    <div class="alert alert-warning">
                        <t t-esc="payment_error"/>
                    </div>
                </t>

                <div class="training-portal-detail">
                    <div class="training-portal-detail__item">
                        <span>Trainer</span>
                        <strong><t t-esc="enrollment.course_id.trainer_id.name"/></strong>
                    </div>

                    <div class="training-portal-detail__item">
                        <span>Enrollment Date</span>
                        <strong><t t-esc="enrollment.enrollment_date"/></strong>
                    </div>

                    <div class="training-portal-detail__item">
                        <span>Status</span>
                        <strong><span class="training-portal-status"><t t-esc="enrollment.state"/></span></strong>
                    </div>

                    <div class="training-portal-detail__item">
                        <span>Course Fee</span>
                        <strong><t t-esc="enrollment.course_fee"/></strong>
                    </div>

                    <div class="training-portal-detail__item">
                        <span>Paid Amount</span>
                        <strong><t t-esc="enrollment.paid_amount"/></strong>
                    </div>

                    <div class="training-portal-detail__item">
                        <span>Due Amount</span>
                        <strong><t t-esc="enrollment.due_amount"/></strong>
                    </div>

                    <div class="training-portal-detail__item training-portal-detail__item--wide"
                         t-if="enrollment.state == 'confirmed' and enrollment.due_amount &gt; 0">
                        <span>Online Payment</span>
                        <a t-att-href="'/my/training/enrollment/%s/pay' % enrollment.id"
                           class="btn training-enroll-primary">
                            Pay Now
                        </a>
                    </div>

                    <div class="training-portal-detail__item training-portal-detail__item--wide"
                         t-if="enrollment.certificate_number">
                        <span>Certificate</span>
                        <a t-att-href="'/report/pdf/Training_academy_management_system.report_training_certificate/%s' % enrollment.id"
                           class="btn training-enroll-primary"
                           target="_blank">
                            Download Certificate
                        </a>
                    </div>
                </div>

            </div>

        </t>

    </template>

</odoo>

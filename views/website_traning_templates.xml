<odoo>

    <template id="website_training_courses" name="Training Courses">
        <t t-call="website.layout">
            <section class="training-catalog-hero">
                <div class="container">
                    <div class="training-catalog-hero__content">
                        <span class="training-eyebrow">Professional learning catalog</span>
                        <h1>Available Training Courses</h1>
                        <p>
                            Choose from instructor-led courses with clear schedules, seats,
                            and enrollment details.
                        </p>
                    </div>
                    <div class="training-catalog-hero__stats">
                        <div>
                            <strong>
                                <t t-esc="len(courses)"/>
                            </strong>
                            <span>Open courses</span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="training-catalog-section">
                <div class="container">
                    <t t-if="courses">
                        <div class="training-course-grid">
                            <t t-foreach="courses" t-as="course">
                                <article class="training-course-card">
                                    <div class="training-course-card__top">
                                        <div class="training-course-icon">
                                            <i class="fa fa-graduation-cap"/>
                                        </div>
                                        <span class="training-course-code">
                                            <t t-esc="course.code or 'Course'"/>
                                        </span>
                                    </div>

                                    <h2>
                                        <t t-esc="course.name"/>
                                    </h2>

                                    <p class="training-course-trainer">
                                        <i class="fa fa-user-o"/>
                                        <span>
                                            <t t-esc="course.trainer_id.name or 'Trainer not assigned'"/>
                                        </span>
                                    </p>

                                    <div class="training-course-meta">
                                        <div>
                                            <span>Fee</span>
                                            <strong>
                                                <t t-esc="'%.2f' % course.final_fee"/>
                                            </strong>
                                        </div>
                                        <div>
                                            <span>Seats</span>
                                            <strong>
                                                <t t-esc="course.available_seats"/>
                                            </strong>
                                        </div>
                                        <div>
                                            <span>Duration</span>
                                            <strong>
                                                <t t-esc="course.duration_days"/> days
                                            </strong>
                                        </div>
                                    </div>

                                    <div class="training-course-footer">
                                        <span class="training-course-date">
                                            <i class="fa fa-calendar-o"/>
                                            <t t-if="course.start_date">
                                                <t t-esc="course.start_date"/>
                                            </t>
                                            <t t-else="">Date pending</t>
                                        </span>
                                        <a t-att-href="'/training/course/%s' % course.id"
                                           class="btn training-course-action">
                                            View Details
                                        </a>
                                    </div>
                                </article>
                            </t>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="training-empty-state">
                            <i class="fa fa-calendar-check-o"/>
                            <h2>No courses are open right now</h2>
                            <p>Confirmed courses with available seats will appear here.</p>
                        </div>
                    </t>
                </div>
            </section>

        </t>
    </template>

    <template id="website_training_course_detail" name="Training Course Detail">
        <t t-call="website.layout">
            <section class="training-detail-hero">
                <div class="container">
                    <a href="/training/courses" class="training-back-link">
                        <i class="fa fa-arrow-left"/>
                        Back to courses
                    </a>

                    <div class="training-detail-hero__content">
                        <div>
                            <span class="training-eyebrow">Course detail</span>
                            <h1>
                                <t t-esc="course.name"/>
                            </h1>
                            <p>
                                Code:
                                <strong>
                                    <t t-esc="course.code or 'Pending'"/>
                                </strong>
                            </p>
                        </div>
                        <div class="training-detail-price">
                            <span>Course fee</span>
                            <strong>
                                <t t-esc="'%.2f' % course.final_fee"/>
                            </strong>
                        </div>
                    </div>
                </div>
            </section>

            <section class="training-detail-section">
                <div class="container">
                    <div class="training-detail-layout">
                        <main class="training-detail-main">
                            <div class="training-section-heading">
                                <span>Overview</span>
                                <h2>Course Information</h2>
                            </div>

                            <div class="training-detail-grid">
                                <div class="training-detail-item">
                                    <i class="fa fa-user-o"/>
                                    <span>Trainer</span>
                                    <strong>
                                        <t t-esc="course.trainer_id.name or 'Not Assigned'"/>
                                    </strong>
                                </div>
                                <div class="training-detail-item">
                                    <i class="fa fa-calendar-o"/>
                                    <span>Start Date</span>
                                    <strong>
                                        <t t-if="course.start_date">
                                            <t t-esc="course.start_date"/>
                                        </t>
                                        <t t-else="">Date pending</t>
                                    </strong>
                                </div>
                                <div class="training-detail-item">
                                    <i class="fa fa-clock-o"/>
                                    <span>Duration</span>
                                    <strong>
                                        <t t-esc="course.duration_days"/> Days
                                    </strong>
                                </div>
                                <div class="training-detail-item">
                                    <i class="fa fa-users"/>
                                    <span>Available Seats</span>
                                    <strong>
                                        <t t-esc="course.available_seats"/>
                                    </strong>
                                </div>
                            </div>
                        </main>

                        <aside class="training-enroll-panel">
                            <div class="training-enroll-panel__icon">
                                <i class="fa fa-check"/>
                            </div>
                            <h2>Enroll Now</h2>
                            <p>Submit your information to reserve a seat in this course.</p>

                            <div class="training-enroll-summary">
                                <div>
                                    <span>Seats open</span>
                                    <strong>
                                        <t t-esc="course.available_seats"/>
                                    </strong>
                                </div>
                                <div>
                                    <span>Duration</span>
                                    <strong>
                                        <t t-esc="course.duration_days"/> days
                                    </strong>
                                </div>
                            </div>

                            <a t-att-href="'/training/course/%s/enroll' % course.id"
                               class="btn training-enroll-primary">
                                Enroll Now
                            </a>

                            <a href="/training/courses"
                               class="btn training-enroll-secondary">
                                Back to Courses
                            </a>
                        </aside>
                    </div>
                </div>
            </section>

        </t>
    </template>

    <template id="website_training_enroll_form" name="Training Enrollment Form">
        <t t-call="website.layout">
            <section class="training-form-section">
                <div class="container">
                    <div class="training-form-layout">
                        <aside class="training-form-summary">
                            <a t-att-href="'/training/course/%s' % course.id" class="training-back-link training-back-link--dark">
                                <i class="fa fa-arrow-left"/>
                                Course details
                            </a>
                            <span class="training-eyebrow">Enrollment request</span>
                            <h1>Enroll in <t t-esc="course.name"/></h1>
                            <p>Share your contact details and the academy team will review your request.</p>

                            <div class="training-form-course-meta">
                                <div>
                                    <span>Fee</span>
                                    <strong><t t-esc="'%.2f' % course.final_fee"/></strong>
                                </div>
                                <div>
                                    <span>Seats</span>
                                    <strong><t t-esc="course.available_seats"/></strong>
                                </div>
                                <div>
                                    <span>Duration</span>
                                    <strong><t t-esc="course.duration_days"/> days</strong>
                                </div>
                            </div>
                        </aside>

                        <div class="training-form-panel">
                            <t t-if="error">
                                <div class="alert alert-danger">
                                    <t t-esc="error"/>
                                </div>
                            </t>

                            <form t-att-action="'/training/course/%s/enroll/submit' % course.id"
                                  method="post"
                                  class="training-enrollment-form">

                                <input type="hidden"
                                       name="csrf_token"
                                       t-att-value="request.csrf_token()"/>

                                <div class="training-form-field">
                                    <label class="form-label">Student Name</label>
                                    <input type="text"
                                           name="name"
                                           class="form-control"
                                           required="required"
                                           placeholder="Your full name"/>
                                </div>

                                <div class="training-form-field">
                                    <label class="form-label">Email</label>
                                    <input type="email"
                                           name="email"
                                           class="form-control"
                                           placeholder="name@example.com"/>
                                </div>

                                <div class="training-form-field">
                                    <label class="form-label">Phone</label>
                                    <input type="text"
                                           name="phone"
                                           class="form-control"
                                           placeholder="Contact number"/>
                                </div>

                                <div class="training-form-field">
                                    <label class="form-label">Address</label>
                                    <textarea name="address"
                                              class="form-control"
                                              rows="4"
                                              placeholder="Street, city, country"/>
                                </div>

                                <div class="training-form-actions">
                                    <button type="submit"
                                            class="btn training-enroll-primary">
                                        Submit Enrollment
                                    </button>

                                    <a t-att-href="'/training/course/%s' % course.id"
                                       class="btn training-enroll-secondary">
                                        Cancel
                                    </a>
                                </div>

                            </form>
                        </div>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <template id="website_training_enroll_success" name="Training Enrollment Success">
        <t t-call="website.layout">
            <section class="training-success-section">
                <div class="container">
                    <div class="training-success-panel">
                        <div class="training-success-icon">
                            <i class="fa fa-check"/>
                        </div>
                        <span class="training-eyebrow">Request received</span>
                        <h1>Enrollment Submitted Successfully</h1>
                        <p>Your enrollment request has been submitted for approval.</p>

                        <div class="training-success-details">
                            <div>
                                <span>Student</span>
                                <strong><t t-esc="student.name"/></strong>
                            </div>
                            <div>
                                <span>Course</span>
                                <strong><t t-esc="course.name"/></strong>
                            </div>
                            <div>
                                <span>Status</span>
                                <strong><t t-esc="enrollment.state"/></strong>
                            </div>
                        </div>

                        <a href="/training/courses"
                           class="btn training-enroll-primary">
                            Back to Courses
                        </a>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <record id="menu_website_training_courses" model="website.menu">
        <field name="name">Training Courses</field>
        <field name="url">/training/courses</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">50</field>
    </record>

</odoo>

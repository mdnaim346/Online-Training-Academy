<odoo>

    <template id="website_training_courses" name="Training Courses">
        <t t-call="website.layout">
            <section class="training-catalog-hero">
                <div class="container">
                    <div class="training-catalog-hero__content">
                        <span class="training-eyebrow">Professional learning catalog</span>
                        <h1>Available Training Courses</h1>
                        <p>
                            Choose from instructor-led courses with clear schedules, seats,
                            and enrollment details.
                        </p>
                    </div>
                    <div class="training-catalog-hero__stats">
                        <div>
                            <strong>
                                <t t-esc="len(courses)"/>
                            </strong>
                            <span>Open courses</span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="training-catalog-section">
                <div class="container">
                    <t t-if="courses">
                        <div class="training-course-grid">
                            <t t-foreach="courses" t-as="course">
                                <article class="training-course-card">
                                    <div class="training-course-card__top">
                                        <div class="training-course-icon">
                                            <i class="fa fa-graduation-cap"/>
                                        </div>
                                        <span class="training-course-code">
                                            <t t-esc="course.code or 'Course'"/>
                                        </span>
                                    </div>

                                    <h2>
                                        <t t-esc="course.name"/>
                                    </h2>

                                    <p class="training-course-trainer">
                                        <i class="fa fa-user-o"/>
                                        <span>
                                            <t t-esc="course.trainer_id.name or 'Trainer not assigned'"/>
                                        </span>
                                    </p>

                                    <div class="training-course-meta">
                                        <div>
                                            <span>Fee</span>
                                            <strong>
                                                <t t-esc="'%.2f' % course.final_fee"/>
                                            </strong>
                                        </div>
                                        <div>
                                            <span>Seats</span>
                                            <strong>
                                                <t t-esc="course.available_seats"/>
                                            </strong>
                                        </div>
                                        <div>
                                            <span>Duration</span>
                                            <strong>
                                                <t t-esc="course.duration_days"/> days
                                            </strong>
                                        </div>
                                    </div>

                                    <div class="training-course-footer">
                                        <span class="training-course-date">
                                            <i class="fa fa-calendar-o"/>
                                            <t t-if="course.start_date">
                                                <t t-esc="course.start_date"/>
                                            </t>
                                            <t t-else="">Date pending</t>
                                        </span>
                                        <a t-att-href="'/training/course/%s' % course.id"
                                           class="btn training-course-action">
                                            View Details
                                        </a>
                                    </div>
                                </article>
                            </t>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="training-empty-state">
                            <i class="fa fa-calendar-check-o"/>
                            <h2>No courses are open right now</h2>
                            <p>Confirmed courses with available seats will appear here.</p>
                        </div>
                    </t>
                </div>
            </section>

        </t>
    </template>

    <template id="website_training_course_detail" name="Training Course Detail">
        <t t-call="website.layout">
            <div class="container py-5">

                <h1>
                    <t t-esc="course.name"/>
                </h1>

                <p class="text-muted">
                    Course Code:
                    <t t-esc="course.code"/>
                </p>

                <hr/>

                <div class="row">
                    <div class="col-md-8">
                        <h4>Course Information</h4>

                        <table class="table table-bordered">
                            <tr>
                                <th>Trainer</th>
                                <td>
                                    <t t-esc="course.trainer_id.name or 'Not Assigned'"/>
                                </td>
                            </tr>

                            <tr>
                                <th>Start Date</th>
                                <td>
                                    <t t-esc="course.start_date"/>
                                </td>
                            </tr>

                            <tr>
                                <th>Duration</th>
                                <td>
                                    <t t-esc="course.duration_days"/> Days
                                </td>
                            </tr>

                            <tr>
                                <th>Fee</th>
                                <td>
                                    <t t-esc="course.final_fee"/>
                                </td>
                            </tr>

                            <tr>
                                <th>Available Seats</th>
                                <td>
                                    <t t-esc="course.available_seats"/>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <div class="col-md-4">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h4>Enroll Now</h4>
                                <p>Submit your information to join this course.</p>

                                <a t-att-href="'/training/course/%s/enroll' % course.id"
                                   class="btn btn-success w-100">
                                    Enroll Now
                                </a>

                                <a href="/training/courses"
                                   class="btn btn-light w-100 mt-2">
                                    Back to Courses
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </t>
    </template>

    <template id="website_training_enroll_form" name="Training Enrollment Form">
        <t t-call="website.layout">
            <div class="container py-5">

                <h1>Enroll in <t t-esc="course.name"/></h1>

                <t t-if="error">
                    <div class="alert alert-danger mt-3">
                        <t t-esc="error"/>
                    </div>
                </t>

                <form t-att-action="'/training/course/%s/enroll/submit' % course.id"
                      method="post"
                      class="mt-4">

                    <input type="hidden"
                           name="csrf_token"
                           t-att-value="request.csrf_token()"/>

                    <div class="mb-3">
                        <label class="form-label">Student Name</label>
                        <input type="text"
                               name="name"
                               class="form-control"
                               required="required"/>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email"
                               name="email"
                               class="form-control"/>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input type="text"
                               name="phone"
                               class="form-control"/>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <textarea name="address"
                                  class="form-control"/>
                    </div>

                    <button type="submit"
                            class="btn btn-success">
                        Submit Enrollment
                    </button>

                    <a t-att-href="'/training/course/%s' % course.id"
                       class="btn btn-light">
                        Cancel
                    </a>

                </form>

            </div>
        </t>
    </template>

    <template id="website_training_enroll_success" name="Training Enrollment Success">
        <t t-call="website.layout">
            <div class="container py-5 text-center">

                <div class="alert alert-success">
                    <h2>Enrollment Submitted Successfully!</h2>
                    <p>
                        Your enrollment request has been submitted for approval.
                    </p>
                </div>

                <h4>
                    Student:
                    <t t-esc="student.name"/>
                </h4>

                <h4>
                    Course:
                    <t t-esc="course.name"/>
                </h4>

                <p>
                    Enrollment Status:
                    <strong>
                        <t t-esc="enrollment.state"/>
                    </strong>
                </p>

                <a href="/training/courses"
                   class="btn btn-primary mt-3">
                    Back to Courses
                </a>

            </div>
        </t>
    </template>

    <record id="menu_website_training_courses" model="website.menu">
        <field name="name">Training Courses</field>
        <field name="url">/training/courses</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">50</field>
    </record>

</odoo>

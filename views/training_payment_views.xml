<odoo>

    <record id="view_training_payment_tree" model="ir.ui.view">
        <field name="name">training.payment.tree</field>
        <field name="model">training.payment</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="payment_date"/>
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="enrollment_id"/>
                <field name="amount"/>
                <field name="payment_method"/>
                <field name="reference"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_training_payment_form" model="ir.ui.view">
        <field name="name">training.payment.form</field>
        <field name="model">training.payment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_posted"
                            type="object"
                            string="Set Posted"
                            class="btn-primary"
                            invisible="state != 'cancelled'"/>

                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            invisible="state == 'cancelled'"/>

                    <button name="%(action_report_training_payment)d"
                            type="action"
                            string="Print Receipt"
                            class="btn-secondary"
                            invisible="state == 'cancelled'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="posted,cancelled"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="enrollment_id"
                                   readonly="state == 'cancelled'"/>
                            <field name="student_id" readonly="1"/>
                            <field name="course_id" readonly="1"/>
                        </group>

                        <group>
                            <field name="payment_date"
                                   readonly="state == 'cancelled'"/>
                            <field name="amount"
                                   readonly="state == 'cancelled'"/>
                            <field name="payment_method"
                                   readonly="state == 'cancelled'"/>
                            <field name="reference"
                                   readonly="state == 'cancelled'"/>
                        </group>
                    </group>

                    <group>
                        <field name="note"
                               readonly="state == 'cancelled'"/>
                    </group>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_training_payment_search" model="ir.ui.view">
        <field name="name">training.payment.search</field>
        <field name="model">training.payment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="enrollment_id"/>

                <filter name="posted"
                        string="Posted"
                        domain="[('state','=','posted')]"/>

                <filter name="cancelled"
                        string="Cancelled"
                        domain="[('state','=','cancelled')]"/>

                <group expand="0" string="Group By">
                    <filter name="group_course"
                            string="Course"
                            context="{'group_by':'course_id'}"/>
                    <filter name="group_student"
                            string="Student"
                            context="{'group_by':'student_id'}"/>
                    <filter name="group_method"
                            string="Payment Method"
                            context="{'group_by':'payment_method'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_training_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">training.payment</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_training_payment"
              name="Payments"
              parent="menu_training_root"
              action="action_training_payment"
              sequence="35"/>

</odoo>

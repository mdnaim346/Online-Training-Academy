<odoo>

    <record id="view_training_enrollment_tree" model="ir.ui.view">
        <field name="name">training.enrollment.tree</field>
        <field name="model">training.enrollment</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'paid'"
                  decoration-info="state == 'waiting_approval'"
                  decoration-warning="state == 'draft'"
                  decoration-danger="state == 'cancelled'">
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="enrollment_date"/>
                <field name="course_fee"/>
                <field name="paid_amount"/>
                <field name="due_amount"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_training_enrollment_form" model="ir.ui.view">
        <field name="name">training.enrollment.form</field>
        <field name="model">training.enrollment</field>
        <field name="arch" type="xml">
            <form>
                <header>

                    <button name="action_submit_for_approval"
                            type="object"
                            string="Submit for Approval"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_approve"
                            type="object"
                            string="Approve"
                            class="btn-success"
                            groups="Training_academy_management_system.group_training_manager"
                            invisible="state != 'waiting_approval'"/>

                    <button name="action_mark_paid"
                            type="object"
                            string="Mark Paid"
                            class="btn-success"
                            invisible="state != 'confirmed'"/>
                    <button name="%(action_report_training_certificate)d"
                            type="action"
                            string="Print Certificate"
                            class="btn-success"
                            invisible="state != 'paid'"/>

                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            invisible="state in ('paid', 'cancelled')"/>

                    <button name="action_reset_to_draft"
                            type="object"
                            string="Reset to Draft"
                            invisible="state not in ('cancelled', 'waiting_approval')"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,waiting_approval,confirmed,paid"/>
                        

                </header>

                <sheet>

                    <group>
                        <group>
                            <field name="student_id"
                                   readonly="state != 'draft'"/>

                            <field name="course_id"
                                   readonly="state != 'draft'"/>

                            <field name="enrollment_date"
                                   readonly="state != 'draft'"/>
                        </group>

                        <group>

                            <field name="course_fee" readonly="1"/>

                            <field name="paid_amount"
                                readonly="state not in ('confirmed', 'paid')"/>

                            <field name="due_amount" readonly="1"/>

                            <field name="certificate_number"
                                readonly="1"
                                invisible="state != 'paid'"/>

                            <field name="completion_date"
                                readonly="1"
                                invisible="state != 'paid'"/>

                        </group>
                    </group>

                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>

            </form>
        </field>
    </record>

    <record id="view_training_enrollment_search" model="ir.ui.view">
        <field name="name">training.enrollment.search</field>
        <field name="model">training.enrollment</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="course_id"/>

                <filter name="draft"
                        string="Draft"
                        domain="[('state','=','draft')]"/>

                <filter name="waiting_approval"
                        string="Waiting Approval"
                        domain="[('state','=','waiting_approval')]"/>

                <filter name="confirmed"
                        string="Confirmed"
                        domain="[('state','=','confirmed')]"/>

                <filter name="paid"
                        string="Paid"
                        domain="[('state','=','paid')]"/>

                <filter name="due_payment"
                        string="Due Payment"
                        domain="[('due_amount','>',0)]"/>

                <group expand="0" string="Group By">
                    <filter name="group_course"
                            string="Course"
                            context="{'group_by':'course_id'}"/>

                    <filter name="group_state"
                            string="Status"
                            context="{'group_by':'state'}"/>

                    <filter name="group_student"
                            string="Student"
                            context="{'group_by':'student_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_training_enrollment" model="ir.actions.act_window">
        <field name="name">Enrollments</field>
        <field name="res_model">training.enrollment</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_training_enrollment"
              name="Enrollments"
              parent="menu_training_root"
              action="action_training_enrollment"
              sequence="30"/>

</odoo>

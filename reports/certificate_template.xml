<odoo>

    <template id="report_training_certificate">

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="o">

                <t t-call="web.external_layout">

                    <div class="page"
                         style="text-align:center;
                                padding-top:100px;">

                        <h1 style="font-size:40px;">
                            Certificate of Completion
                        </h1>

                        <br/><br/>

                        <p style="font-size:22px;">
                            This is to certify that
                        </p>

                        <h2 style="font-size:36px;">
                            <span t-field="o.student_id.name"/>
                        </h2>

                        <br/>

                        <p style="font-size:22px;">
                            has successfully completed the course
                        </p>

                        <h2 style="font-size:32px;">
                            <span t-field="o.course_id.name"/>
                        </h2>

                        <br/><br/>

                        <p style="font-size:20px;">
                            Trainer:
                            <strong>
                                <span t-field="o.course_id.trainer_id.name"/>
                            </strong>
                        </p>

                        <p style="font-size:20px;">
                            Completion Date:
                            <strong>
                                <span t-field="o.completion_date"/>
                            </strong>
                        </p>

                        <p style="font-size:20px;">
                            Certificate Number:
                            <strong>
                                <span t-field="o.certificate_number"/>
                            </strong>
                        </p>

                        <br/><br/><br/><br/>

                        <div style="margin-top:80px;">

                            <div style="width:300px;
                                        margin:auto;">

                                <hr/>

                                <strong>
                                    Authorized Signature
                                </strong>

                            </div>

                        </div>

                    </div>

                </t>

            </t>

        </t>

    </template>

</odoo>
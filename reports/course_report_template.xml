<odoo>

    <template id="report_training_course_template">

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="o">

                <t t-call="web.external_layout">

                    <div class="page">

                        <h2>
                            Training Course Report
                        </h2>

                        <br/>

                        <table class="table table-sm table-bordered">

                            <tbody>

                                <tr>
                                    <th width="30%">Course Code</th>
                                    <td>
                                        <span t-field="o.code"/>
                                    </td>
                                </tr>

                                <tr>
                                    <th>Course Name</th>
                                    <td>
                                        <span t-field="o.name"/>
                                    </td>
                                </tr>

                                <tr>
                                    <th>Trainer</th>
                                    <td>
                                        <span t-field="o.trainer_id.name"/>
                                    </td>
                                </tr>

                                <tr>
                                    <th>Start Date</th>
                                    <td>
                                        <span t-field="o.start_date"/>
                                    </td>
                                </tr>

                                <tr>
                                    <th>Duration</th>
                                    <td>
                                        <span t-field="o.duration_days"/>
                                        Days
                                    </td>
                                </tr>

                                <tr>
                                    <th>Course Fee</th>
                                    <td>
                                        <span t-field="o.fee"/>
                                    </td>
                                </tr>

                                <tr>
                                    <th>Discount</th>
                                    <td>
                                        <span t-field="o.discount"/>
                                    </td>
                                </tr>

                                <tr>
                                    <th>Final Fee</th>
                                    <td>
                                        <strong>
                                            <span t-field="o.final_fee"/>
                                        </strong>
                                    </td>
                                </tr>

                                <tr>
                                    <th>Status</th>
                                    <td>
                                        <span t-field="o.state"/>
                                    </td>
                                </tr>

                            </tbody>

                        </table>

                        <br/>

                        <h4>
                            Enrollment Summary
                        </h4>

                        <table class="table table-sm table-striped">

                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>Date</th>
                                    <th>Fee</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>

                                <tr t-foreach="o.enrollment_ids"
                                    t-as="enrollment">

                                    <td>
                                        <span t-field="enrollment.student_id.name"/>
                                    </td>

                                    <td>
                                        <span t-field="enrollment.enrollment_date"/>
                                    </td>

                                    <td>
                                        <span t-field="enrollment.course_fee"/>
                                    </td>

                                    <td>
                                        <span t-field="enrollment.state"/>
                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>

                </t>

            </t>

        </t>

    </template>

</odoo>
<odoo>

    <template id="report_training_enrollment_template">

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="o">

                <t t-call="web.external_layout">

                    <div class="page">

                        <h2>
                            Enrollment Receipt
                        </h2>

                        <br/>

                        <table class="table table-bordered">

                            <tbody>

                                <tr>
                                    <th width="30%">
                                        Student
                                    </th>

                                    <td>
                                        <span t-field="o.student_id.name"/>
                                    </td>
                                </tr>

                                <tr>
                                    <th>
                                        Course
                                    </th>

                                    <td>
                                        <span t-field="o.course_id.name"/>
                                    </td>
                                </tr>

                                <tr>
                                    <th>
                                        Enrollment Date
                                    </th>

                                    <td>
                                        <span t-field="o.enrollment_date"/>
                                    </td>
                                </tr>

                                <tr>
                                    <th>
                                        Course Fee
                                    </th>

                                    <td>
                                        <span t-field="o.course_fee"/>
                                    </td>
                                </tr>

                                <tr>
                                    <th>
                                        Paid Amount
                                    </th>

                                    <td>
                                        <span t-field="o.paid_amount"/>
                                    </td>
                                </tr>

                                <tr>
                                    <th>
                                        Due Amount
                                    </th>

                                    <td>
                                        <strong>
                                            <span t-field="o.due_amount"/>
                                        </strong>
                                    </td>
                                </tr>

                                <tr>
                                    <th>
                                        Status
                                    </th>

                                    <td>
                                        <span t-field="o.state"/>
                                    </td>
                                </tr>

                            </tbody>

                        </table>

                        <br/>

                        <h4>Payment History</h4>

                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Receipt</th>
                                    <th>Date</th>
                                    <th>Method</th>
                                    <th>Reference</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.payment_ids.filtered(lambda payment: payment.state != 'cancelled')"
                                   t-as="payment">
                                    <tr>
                                        <td>
                                            <span t-field="payment.name"/>
                                        </td>
                                        <td>
                                            <span t-field="payment.payment_date"/>
                                        </td>
                                        <td>
                                            <span t-field="payment.payment_method"/>
                                        </td>
                                        <td>
                                            <span t-field="payment.reference"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="payment.amount"/>
                                        </td>
                                    </tr>
                                </t>
                                <t t-if="not o.payment_ids.filtered(lambda payment: payment.state != 'cancelled')">
                                    <tr>
                                        <td colspan="5" class="text-center">
                                            No payments recorded.
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <br/>

                        <div class="mt32">

                            <strong>
                                Authorized Signature
                            </strong>

                            <br/><br/><br/>

                            ____________________

                        </div>

                    </div>

                </t>

            </t>

        </t>

    </template>

</odoo>

<odoo>

    <template id="report_training_enrollment_template">

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="o">

                <t t-call="web.external_layout">

                    <div class="page">

                        <h2>
                            Enrollment Receipt
                        </h2>

                        <br/>

                        <table class="table table-bordered">

                            <tbody>

                                <tr>
                                    <th width="30%">
                                        Student
                                    </th>

                                    <td>
                                        <span t-field="o.student_id.name"/>
                                    </td>
                                </tr>

                                <tr>
                                    <th>
                                        Course
                                    </th>

                                    <td>
                                        <span t-field="o.course_id.name"/>
                                    </td>
                                </tr>

                                <tr>
                                    <th>
                                        Enrollment Date
                                    </th>

                                    <td>
                                        <span t-field="o.enrollment_date"/>
                                    </td>
                                </tr>

                                <tr>
                                    <th>
                                        Course Fee
                                    </th>

                                    <td>
                                        <span t-field="o.course_fee"/>
                                    </td>
                                </tr>

                                <tr>
                                    <th>
                                        Paid Amount
                                    </th>

                                    <td>
                                        <span t-field="o.paid_amount"/>
                                    </td>
                                </tr>

                                <tr>
                                    <th>
                                        Due Amount
                                    </th>

                                    <td>
                                        <strong>
                                            <span t-field="o.due_amount"/>
                                        </strong>
                                    </td>
                                </tr>

                                <tr>
                                    <th>
                                        Status
                                    </th>

                                    <td>
                                        <span t-field="o.state"/>
                                    </td>
                                </tr>

                            </tbody>

                        </table>

                        <br/>

                        <div class="mt32">

                            <strong>
                                Authorized Signature
                            </strong>

                            <br/><br/><br/>

                            ____________________

                        </div>

                    </div>

                </t>

            </t>

        </t>

    </template>

</odoo>
<odoo>
    <record id="seq_training_course" model="ir.sequence">
        <field name="name">Training Course</field>
        <field name="code">training.course</field>
        <field name="prefix">COURSE/</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_training_payment" model="ir.sequence">
        <field name="name">Training Payment Receipt</field>
        <field name="code">training.payment</field>
        <field name="prefix">PAY/</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_training_payment_transaction" model="ir.sequence">
        <field name="name">Training Payment Transaction</field>
        <field name="code">training.payment.transaction</field>
        <field name="prefix">TXN/</field>
        <field name="padding">5</field>
    </record>
</odoo>

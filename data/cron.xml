<odoo>

    <record id="ir_cron_complete_old_courses" model="ir.cron">
        <field name="name">Training: Auto Complete Old Courses</field>
        <field name="model_id" ref="model_training_course"/>
        <field name="state">code</field>
        <field name="code">model._cron_complete_old_courses()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_followup_due_payments" model="ir.cron">
        <field name="name">Training: Payment Follow-up Activities</field>
        <field name="model_id" ref="model_training_enrollment"/>
        <field name="state">code</field>
        <field name="code">model._cron_followup_due_payments()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

</odoo>